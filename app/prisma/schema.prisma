// ============================================================
// HW Catalog — Galeri Ayam Bangkok
// Prisma schema untuk produksi (PostgreSQL, mis. Neon/Supabase).
// Jalankan migrasi dengan `prisma migrate deploy` lalu `prisma db seed`.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  nama         String
  email        String    @unique
  passwordHash String
  role         String    @default("ADMIN") // "PEMILIK" = semua akses + kelola admin; "ADMIN" = dibatasi modul
  izin         String[]  @default([])      // modul yang boleh diakses ADMIN: ayam, kategori, riwayat, permintaan, laporan, log
  aktif        Boolean   @default(true)    // false = tidak bisa login
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  logs         Log[]
}

model Kategori {
  id        Int     @id @default(autoincrement())
  nama      String  @unique
  slug      String  @unique
  deskripsi String?
  urutan    Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ayam      Ayam[]
}

model Ayam {
  id              Int        @id @default(autoincrement())
  slug            String     @unique
  kodeRing        String?    @unique // nomor ring; boleh kosong
  nama            String
  kategoriId      Int?
  kategori        Kategori?  @relation(fields: [kategoriId], references: [id], onDelete: SetNull)
  jenisKelamin    String // JANTAN | BETINA
  tanggalMenetas  DateTime? // perkiraan; usia = dihitung aplikasi
  beratKg         Float
  warnaBulu       String?
  postur          String? // ukuran & ciri yang lazim ditanya pembeli
  tinggiCm        Float?
  kakiSisik       String?
  jalu            String? // BELUM | TUNGGAL | GANDA
  keunggulan      String?
  deskripsi       String?
  harga           Int? // NULL = "Hubungi kami"
  statusJual      String   @default("TERSEDIA") // TERSEDIA | DIPESAN | TERJUAL
  statusTampil    String   @default("DRAFT") // DRAFT | PUBLIKASI
  isFeatured      Boolean  @default(false)
  isArsip         Boolean  @default(false) // soft delete
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  images          AyamImage[]
  permintaan      Permintaan[]
  laporan         Laporan[]
  riwayat         RiwayatTarung[]
}

model AyamImage {
  id         Int      @id @default(autoincrement())
  ayamId     Int
  ayam       Ayam     @relation(fields: [ayamId], references: [id], onDelete: Cascade)
  filePath   String
  ukuranKb   Int?
  altText    String?
  jenisFoto  String? // FULL_BADAN | KEPALA | KAKI | BULU | LAINNYA
  isPrimary  Boolean  @default(false)
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())
}

model Permintaan {
  id              Int      @id @default(autoincrement())
  ayamId          Int?
  ayam            Ayam?    @relation(fields: [ayamId], references: [id], onDelete: SetNull)
  namaPengunjung  String
  noWa            String
  kota            String?
  pesan           String?
  status          String   @default("BARU") // BARU | DIHUBUNGI | DEAL | BATAL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Laporan {
  id         Int      @id @default(autoincrement())
  ayamId     Int?
  ayam       Ayam?    @relation(fields: [ayamId], references: [id], onDelete: SetNull)
  namaPelapor String?
  noWa       String?
  jenis      String   @default("LAINNYA")
  isi        String?
  status     String   @default("BARU") // BARU | DITINDAKLANJUTI | SELESAI | TUTUP
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RiwayatTarung {
  id          Int      @id @default(autoincrement())
  ayamId      Int
  ayam        Ayam     @relation(fields: [ayamId], references: [id], onDelete: Cascade)
  tanggal     DateTime
  jenisLaga   String   @default("UJI_TERBATAS") // UJI_TERBATAS | ADU_RESMI
  namaLawan   String?
  beratLawan  Float?
  ronde       Int?
  hasil       String // MENANG | KALAH | SERI
  catatan     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Log {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  aksi      String // LOGIN | LOGIN_GAGAL | LOGOUT | CREATE | UPDATE | DELETE | ARSIP | PULIHKAN | UBAH_STATUS | UBAH_IZIN | LAINNYA
  entitas   String
  entitasId Int?
  detail    String?
  email     String?   // email pelaku (untuk login gagal yg tak punya userId)
  ip        String?
  negara    String?
  kota      String?
  perangkat String?   // ringkas: mis. "HP · Android" / "PC · Windows"
  browser   String?
  os        String?
  createdAt DateTime  @default(now())
}

// Papan pengumuman publik (peringatan / iklan / info) — pita di bagian paling
// atas halaman pengunjung. Dikelola sepenuhnya dari panel pemilik.
model PapanInfo {
  id        Int      @id @default(autoincrement())
  jenis     String   @default("PERINGATAN") // PERINGATAN | IKLAN | INFO
  judul     String
  pesan     String
  aktif     Boolean  @default(false)
  kedip     Boolean  @default(true) // indikator titik kedap-kedip
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SATU-SATUNYA sumber data kontak & info situs (baris id = 1).
// Nilai di sini dipakai semua halaman pengunjung (footer, beranda, katalog,
// detail ayam, form minat) dan diedit lewat panel pemilik — tanpa sentuh kode.
model SiteSetting {
  id               Int      @id @default(1)
  pemilik          String   @default("Pemilik Demo")
  waNumber         String   @default("6280000000000") // format internasional: 62…
  waDisplay        String   @default("+62 800-0000-0000")
  email            String   @default("") // kosong = "segera menyusul"
  sosmed           String   @default("") // URL lengkap, mis. https://instagram.com/…
  alamatBaris1     String   @default("Pedan, Kab. Klaten,")
  alamatBaris2     String   @default("Jawa Tengah, Indonesia")
  mapsUrl          String   @default("https://maps.google.com/?q=Pedan+Klaten+Jawa+Tengah")
  jamLayanan       String   @default("08:00 – 17:00 WIB")
  catatanKunjungan String   @default("Kunjungan wajib reservasi (janji temu). Chat WhatsApp dulu untuk mencocokkan jadwal pemilik — tanpa janji, mohon tidak datang langsung.")
  updatedAt        DateTime @updatedAt
}

