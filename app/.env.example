# ===== JALU — contoh lingkungan pengembangan =====
# Salin sebagai .env lalu sesuaikan.
# SQLite dipakai untuk demo lokal tanpa setup database.
# Produksi (MySQL 8): ubah provider datasource di prisma/schema.prisma menjadi
# "mysql" dan isi DATABASE_URL mysql://user:pass@host:3306/nama_db, lalu `npm run db:push`.
DATABASE_URL="file:./dev.db"

# Kunci penandatanganan sesi login panel — ganti nilai acak panjang di produksi.
SESSION_SECRET="ganti-dengan-random-panjang-di-produksi"

# URL publik aplikasi (dipakai untuk redirect login/back).
# APP_URL="https://kandang.example"
