# ============================================================
# HW Catalog — contoh environment. Salin ke .env untuk lokal.
# Di Vercel: Settings → Environment Variables (Production/Preview).
# ============================================================

# PostgreSQL (produksi; disarankan Neon/Supabase free tier).
# Lokal bisa diisi ke instance postgres lokal, contoh:
#   postgresql://USER:PASSWORD@localhost:5432/hwcatalog?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public

# Kunci sesi login panel — wajib diganti nilai acak panjang di produksi,
# mis. hasil dari: openssl rand -hex 32
SESSION_SECRET=ganti_dengan_string_acak_panjang

# Token Vercel Blob untuk simpan foto unggahan (opsional di dev).
# Di Vercel: Storage → Create → Blob → copy "BLOB_READ_WRITE_TOKEN".
# Tanpa token, foto disimpan ke public/uploads (hanya untuk dev lokal).
BLOB_READ_WRITE_TOKEN=

# Setelah database siap, jalankan sekali:
#   npx prisma migrate deploy
#   npm run db:seed   (menghasilkan akun admin@jalu.id / jalu1234)
